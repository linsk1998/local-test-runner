{
	"compilerOptions": {
		"target": "ESNext",
		"module": "ES2020",
		"lib": [
			"ES2020",
			"DOM"
		],
		"moduleResolution": "Node",
		"isolatedModules": false,
		"esModuleInterop": false,
		"resolveJsonModule": true,
		"paths": {
			"@/*": [
				"./src/*"
			]
		},
		"jsx": "preserve",
		"useDefineForClassFields": true,
		"strict": true,
		"strictNullChecks": false,
		"noImplicitAny": false
	},
	"include": [
		"src/**/*",
		"types/**/*"
	]
}