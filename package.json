{
	"name": "local-test-runner",
	"version": "0.0.0",
	"description": "Run front-end tests in locally installed real browsers — Chrome, Firefox, Safari (WebKit), Opera, Edge and IE mode.",
	"main": "dist/index.js",
	"exports": {
		".": {
			"require": "./dist/index.js",
			"default": "./dist/index.js"
		},
		"./package.json": "./package.json"
	},
	"files": [
		"dist"
	],
	"keywords": [
		"test-runner",
		"browser-testing",
		"cross-browser",
		"qunit",
		"mocha",
		"karma",
		"web-testing",
		"e2e"
	],
	"author": "linsk",
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/linsk1998/local-test-runner.git"
	},
	"homepage": "https://github.com/linsk1998/local-test-runner#readme",
	"bugs": {
		"url": "https://github.com/linsk1998/local-test-runner/issues"
	},
	"sideEffects": false,
	"engines": {
		"node": ">=16"
	},
	"scripts": {
		"build": "rollup -c",
		"watch": "rollup -c -w",
		"prepublishOnly": "pnpm build",
		"publish:npm": "npm publish --registry=https://registry.npmjs.org"
	},
	"packageManager": "pnpm@10.32.1",
	"dependencies": {
		"connect": "^3.7.0",
		"escape-html": "1.0.3",
		"http-proxy": "^1.18.1",
		"magic-string": "^0.30.21",
		"parse5": "^8.0.1",
		"picocolors": "^1.1.1",
		"picomatch": "^4.0.4",
		"serve-static": "^2.2.1",
		"tinyglobby": "^0.2.16",
		"tslib": "^2.8.1"
	},
	"devDependencies": {
		"@rollup/plugin-typescript": "^12.3.0",
		"@types/connect": "^3.4.38",
		"@types/http-proxy": "^1.17.17",
		"@types/picomatch": "^4.0.3",
		"@types/serve-static": "^2.2.0",
		"builtin-modules": "^5.2.0",
		"fs-extra": "^11.3.5",
		"rollup": "^3.30.0",
		"typescript": "^5.3.3"
	}
}